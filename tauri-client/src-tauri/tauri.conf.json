{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Threadbear Tauri",
  "version": "0.3.0",
  "identifier": "io.github.eeharumt.threadbear.tauri",
  "build": {
    "frontendDist": "../phone/dist",
    "devUrl": "http://localhost:5182",
    "beforeDevCommand": "node ../node_modules/vite/bin/vite.js --config phone/vite.config.mts",
    "beforeBuildCommand": "node ../node_modules/vite/bin/vite.js build --config phone/vite.config.mts"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Threadbear Tauri",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "capabilities": [
        "bundled"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
